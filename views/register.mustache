{{> head}}
{{> header}}

<main class="auth-page">
  <div class="auth-card">
    <h1>Create Account</h1>
    <p class="muted">Join the studio and start booking classes.</p>

    {{#error}}
    <div class="alert error" role="alert">{{error}}</div>
    {{/error}}

    <form method="post" action="/register">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      <div class="field">
        <label for="username">Username</label>
        {{user_name_error}}
        <input type="text" id="username" name="username" placeholder="Choose a username" required autofocus>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Enter your email address" required>
      </div>

      <div class="field">
        <label for="pass">Password <span class="muted">(8 characters minimum)</span></label>
        <input type="password" id="pass" name="pass" placeholder="Create a password" minlength="8" required>
      </div>

      <div class="actions">
        <button class="btn primary" type="submit">Create Account</button>
        <a href="/login">Already have an account? Sign in</a>
      </div>
    </form>
  </div>
</main>

{{> footer}}
