{{> head}}
{{> header}}

<main>
  <div class="wrap">
    <h1>Upcoming Courses</h1>
    <p>Our Yoga studio is located at 60 High Street, Glasgow, G1 1AA.</p>
    <p>We offer a variety of classes for all levels, from beginners to advanced practitioners.</p>
    <p class="muted">Browse our classes and book your spot.</p>

    <div class="cards">
      {{#courses}}
      <article class="card">
        <h2><a href="/courses/{{id}}">{{title}}</a></h2>
        <p class="muted">{{level}} &bull; {{type}} {{#allowDropIn}}&bull; Drop-in welcome{{/allowDropIn}}</p>
        <p>{{description}}</p>
        <p class="muted">{{startDate}} &ndash; {{endDate}}</p>
        <p class="muted">Next: {{nextSession}} &bull; {{sessionsCount}} sessions</p>
        <div class="actions">
          <a class="btn primary" href="/courses/{{id}}">View &amp; Book</a>
        </div>
      </article>
      {{/courses}}

      {{^courses}}
        <p>No courses available yet.</p>
      {{/courses}}
    </div>
  </div>
</main>

{{> footer}}


